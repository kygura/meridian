{
  "name": "meridian",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "start": "tsx server/index.ts",
    "dev:all": "concurrently \"vite\" \"tsx watch server/index.ts\"",
    "dev:client": "vite",
    "dev:server": "tsx watch server/index.ts",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build:data": "bun scripts/build-airports.mjs",
    "build:place-data": "tsx scripts/build-place-data.ts",
    "build:coast": "tsx scripts/build-city-coast.ts",
    "build:countries": "tsx scripts/build-countries.ts",
    "build:visa": "tsx scripts/build-visa-data.ts",
    "build:seasonality": "bun scripts/build-seasonality.mjs",
    "backfill:climate": "tsx scripts/backfill-climate.ts",
    "build:vercel": "npm run build && node scripts/build-vercel.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.6.0",
    "@hono/node-server": "^1.13.0",
    "ai": "^4.3.0",
    "csv-parse": "^5.6.0",
    "dotenv": "^17.4.2",
    "exifr": "7.1.3",
    "fast-xml-parser": "^5.8.0",
    "hono": "^4.7.0",
    "maplibre-gl": "^5.1.0",
    "postgres": "^3.4.9",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^3.24.0",
    "zod-to-json-schema": "^3.25.2",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@photostructure/tz-lookup": "^11.8.0",
    "@types/node": "^22.20.5",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.4.0",
    "autoprefixer": "^10.4.0",
    "concurrently": "^9.1.0",
    "esbuild": "^0.28.0",
    "hyparquet": "^1.33.0",
    "pngjs": "^7.0.0",
    "postcss": "^8.5.0",
    "tailwindcss": "^3.4.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0",
    "vite": "^6.3.0",
    "vitest": "^4.1.9"
  }
}
