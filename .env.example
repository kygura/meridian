# Claude for Ask, city research and the city news briefing. Without a key, Ask runs its
# mock path and the briefing is rule-based.
ANTHROPIC_API_KEY=
# Default model for Ask and research (claude-opus-5-5 | claude-sonnet-5-5 | claude-haiku-5-5).
# Ask also lets you switch per browser. Default claude-opus-5-5.
AGENT_MODEL=
# Model for the city news briefing. Default claude-haiku-5-5.
NEWS_BRIEF_MODEL=
# Personal data storage: JSON files under DATA_DIR (needs a persistent disk), or
# Postgres when DATABASE_URL is set (any provider; the table is created on first use).
DATA_DIR=
DATABASE_URL=
VITE_API_BASE_URL=

# Real flight/stay pricing (optional — falls back to deterministic mock
# pricing when unset). Duffel is tried first; SerpAPI fills route gaps and
# supplies real-market deal ratings. See server/lib/flightSearch.ts.
DUFFEL_API_KEY=
SERPAPI_KEY=

# The owner's password (sign in under Settings > Account) and the Bearer token for
# automation. Gates /api/journal, /api/replay, /api/import, /api/watches, /api/trips,
# /api/bookings, shortlist writes, and Ask / flight search once their provider keys
# are set. Unset = those routes fail closed with 401. Use a long random value,
# e.g. `openssl rand -hex 32`.
MERIDIAN_TOKEN=
# Signs the session cookie. Optional: when unset, the signing key is derived from
# MERIDIAN_TOKEN (changing the password then signs every browser out).
SESSION_SECRET=
# Days a sign-in lasts. Default 30.
SESSION_TTL_DAYS=
# Only when the frontend is served from another origin than the API: the origins
# allowed to call the API with the session cookie, comma-separated.
MERIDIAN_ALLOWED_ORIGINS=
# Proxy hops in front of the server (e.g. 1 behind one load balancer), so rate limits
# and the sign-in lockout see the real client address. Leave unset on Vercel.
TRUST_PROXY=
# Optional: JSON POST target for watch alerts (spec-journal §10).
# Watches only run when something POSTs /api/watches/run with this token daily
# (a Render Cron Job or a scheduled Claude task; not provisioned by render.yaml).
ALERT_WEBHOOK_URL=
# Vercel only: Vercel Cron sends this as a bearer token to GET /api/watches/run.
# Any value of its own (it opens that one route only), or the same as MERIDIAN_TOKEN.
CRON_SECRET=

# Climate normals backfill (ADR 0014). A nightly job fills the next gaps in monthly air quality
# and weekly climate normals from Open-Meteo's free tier, a budget of weighted calls per run.
# CLIMATE_JOB=off disables it. The ceilings stay under the free tier's 5,000/hour and 10,000/day.
CLIMATE_JOB=
CLIMATE_JOB_HOUR_UTC=3
CLIMATE_JOB_BUDGET=2500
OPEN_METEO_MINUTELY_BUDGET=400
OPEN_METEO_HOURLY_BUDGET=3500
OPEN_METEO_DAILY_BUDGET=7000
