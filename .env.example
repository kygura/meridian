# Claude for Ask, city research and the city news briefing. Without a key, Ask runs its
# mock path and the briefing is rule-based.
ANTHROPIC_API_KEY=
# Default model for Ask and research (claude-opus-5-5 | claude-sonnet-5-5 | claude-haiku-5-5).
# Ask also lets you switch per browser. Default claude-opus-5-5.
AGENT_MODEL=
# Model for the city news briefing. Default claude-haiku-5-5.
NEWS_BRIEF_MODEL=
# Personal data storage: JSON files under DATA_DIR (needs a persistent disk), or
# Postgres when DATABASE_URL is set (any provider; the table is created on first use).
DATA_DIR=
DATABASE_URL=
VITE_API_BASE_URL=

# Real flight/stay pricing (optional — falls back to deterministic mock
# pricing when unset). Duffel is tried first; SerpAPI fills route gaps and
# supplies real-market deal ratings. See server/lib/flightSearch.ts.
DUFFEL_API_KEY=
SERPAPI_KEY=

# Bearer token for the personal-data routes (/api/journal, /api/replay,
# /api/import, /api/watches, /api/trips). Unset = those routes fail closed with 401.
MERIDIAN_TOKEN=
# Optional: JSON POST target for watch alerts (spec-journal §10).
# Watches only run when something POSTs /api/watches/run with this token daily
# (a Render Cron Job or a scheduled Claude task; not provisioned by render.yaml).
ALERT_WEBHOOK_URL=
# Vercel only: Vercel Cron sends this as a bearer token to GET /api/watches/run.
# Set it to the same value as MERIDIAN_TOKEN.
CRON_SECRET=
