# Claude for Ask, city research and the city news briefing. Without a key, Ask runs its
# mock path and the briefing is rule-based.
ANTHROPIC_API_KEY=
# Default model for Ask and research (claude-opus-5-5 | claude-sonnet-5-5 | claude-haiku-5-5).
# Ask also lets you switch per browser. Default claude-opus-5-5.
AGENT_MODEL=
# Model for the city news briefing. Default claude-haiku-5-5.
NEWS_BRIEF_MODEL=
# Personal data storage: JSON files under DATA_DIR (needs a persistent disk), or
# Postgres when DATABASE_URL is set (any provider; the table is created on first use).
DATA_DIR=
DATABASE_URL=
VITE_API_BASE_URL=

# Real flight/stay pricing (optional — falls back to deterministic mock
# pricing when unset). Duffel is tried first; SerpAPI fills route gaps and
# supplies real-market deal ratings. See server/lib/flightSearch.ts.
DUFFEL_API_KEY=
SERPAPI_KEY=

# The owner's password (sign in under Settings > Account) and the Bearer token for
# automation. Gates /api/journal, /api/replay, /api/import, /api/watches, /api/trips,
# /api/bookings, shortlist writes, and Ask / flight search once their provider keys
# are set. Unset = those routes fail closed with 401. Use a long random value,
# e.g. `openssl rand -hex 32`.
MERIDIAN_TOKEN=
# Signs the session cookie. Optional: when unset, the signing key is derived from
# MERIDIAN_TOKEN (changing the password then signs every browser out).
SESSION_SECRET=
# Days a sign-in lasts. Default 30.
SESSION_TTL_DAYS=
# Only when the frontend is served from another origin than the API: the origins
# allowed to call the API with the session cookie, comma-separated.
MERIDIAN_ALLOWED_ORIGINS=
# Proxy hops in front of the server (e.g. 1 behind one load balancer), so rate limits
# and the sign-in lockout see the real client address. Leave unset on Vercel.
TRUST_PROXY=
# Alerts (ADR 0016). Every alert is kept in the app's Alerts list; each channel below is
# optional and independent.
# JSON POST target for every alert.
ALERT_WEBHOOK_URL=
# Public address of the app, so alerts can link back (else RENDER_EXTERNAL_URL / Vercel's URL).
PUBLIC_URL=
# Email: Resend (RESEND_API_KEY) or SMTP (SMTP_URL=smtp://user:pass@host:587), plus recipients.
RESEND_API_KEY=
SMTP_URL=
ALERT_EMAIL_TO=
ALERT_EMAIL_FROM=
# Telegram bot.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# ntfy topic (NTFY_SERVER for a self-hosted server, NTFY_TOKEN for a protected topic).
NTFY_TOPIC=
NTFY_SERVER=
NTFY_TOKEN=
# Web Push: `node scripts/generate-vapid.mjs`; VAPID_SUBJECT is mailto:you@example.com or an https URL.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
# Daily jobs on a long-running server: UTC time HH:MM (default 06:17); DAILY_JOBS=off to disable.
DAILY_JOBS_AT=
DAILY_JOBS=
# Vercel only: Vercel Cron sends this as a bearer token to GET /api/jobs/daily.
# Any value of its own (it opens that route and /api/watches/run only), or the same as MERIDIAN_TOKEN.
CRON_SECRET=

# Climate normals backfill (ADR 0014). A nightly job fills the next gaps in monthly air quality
# and weekly climate normals from Open-Meteo's free tier, a budget of weighted calls per run.
# CLIMATE_JOB=off disables it. The ceilings stay under the free tier's 5,000/hour and 10,000/day.
CLIMATE_JOB=
CLIMATE_JOB_HOUR_UTC=3
CLIMATE_JOB_BUDGET=2500
OPEN_METEO_MINUTELY_BUDGET=400
OPEN_METEO_HOURLY_BUDGET=3500
OPEN_METEO_DAILY_BUDGET=7000
# Notion import (ADR 0017). An internal integration token, with your databases shared to it.
# Without it you can still upload a Notion export in Settings > Notion.
NOTION_TOKEN=
NOTION_SEASONS_DB=
NOTION_RESEARCH_DB=
NOTION_RESEARCH_PAGE=
# Writing the rotation back to a Notion database: set to 1 to allow it (and switch it on in Settings).
NOTION_WRITE_BACK=
NOTION_WRITE_BACK_DB=

# In-app Gmail import (ADR 0017): a Google OAuth web client (Gmail API enabled), and a secret of
# 32+ characters that encrypts the saved refresh token (e.g. `openssl rand -hex 32`).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GMAIL_TOKEN_KEY=
# Only when a proxy hides the public address; otherwise <this server>/api/gmail/callback.
GOOGLE_REDIRECT_URI=
# How far back the first sync reads. Default: three years.
GMAIL_BACKFILL_FROM_YEAR=
